{
  "name": "autoscroll-extension",
  "version": "1.0.0",
  "description": "Human-like autoscroll extension with advanced stealth capabilities",
  "type": "module",
  "main": "dist/background.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --mode=development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit --verbose",
    "test:integration": "jest --testPathPattern=integration --verbose",
    "test:stealth": "jest --testPathPattern=stealth --verbose",
    "test:performance": "jest --testPathPattern=performance --verbose",
    "test:e2e": "jest --testPathPattern=e2e --verbose",
    "test:all": "jest --verbose --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:update-snapshots": "jest --updateSnapshot",
    "test:clear-cache": "jest --clearCache",
    "test:detect-open-handles": "jest --detectOpenHandles",
    "test:detect-leaks": "jest --detectLeaks",
    "test:force-exit": "jest --forceExit",
    "test:silent": "jest --silent",
    "test:no-cache": "jest --no-cache",
    "test:max-workers": "jest --maxWorkers=4",
    "test:run-in-band": "jest --runInBand",
    "test:only-changed": "jest --onlyChanged",
    "test:changed-files": "jest --changedFilesWithAncestor",
    "test:pass-with-no-tests": "jest --passWithNoTests",
    "test:report": "jest --coverage --coverageReporters=html",
    "test:coverage:html": "jest --coverage --coverageReporters=html --coverageDirectory=coverage/html",
    "test:coverage:lcov": "jest --coverage --coverageReporters=lcov --coverageDirectory=coverage/lcov",
    "test:coverage:json": "jest --coverage --coverageReporters=json --coverageDirectory=coverage/json",
    "test:coverage:all": "jest --coverage --coverageReporters=text,lcov,html,json --coverageDirectory=coverage",
    "test:coverage:threshold": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":15,\"functions\":15,\"lines\":15,\"statements\":15}}'",
    "test:coverage:strict": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":25,\"functions\":25,\"lines\":25,\"statements\":25}}'",
    "test:json": "jest --json --outputFile=test-results.json",
    "test:junit": "jest --reporters=default --reporters=jest-junit",
    "coverage:open": "open coverage/html/index.html",
    "coverage:clean": "rm -rf coverage",
    "coverage:check": "jest --coverage --passWithNoTests --coverageThreshold='{\"global\":{\"branches\":15,\"functions\":15,\"lines\":15,\"statements\":15}}'",
    "quality:check": "npm run lint && npm run test:coverage:threshold && npm run security:check",
    "quality:strict": "npm run lint && npm run test:coverage:strict && npm run security:check",
    "quality:gates": "node scripts/quality-gates.js",
    "quality:gates:coverage": "node scripts/coverage-analysis.js",
    "quality:gates:all": "npm run quality:gates && npm run quality:gates:coverage",
    "quality:report": "npm run quality:gates:all && npm run coverage:open",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "format": "prettier --write src/**/*.js tests/**/*.js",
    "type-check": "tsc --noEmit",
    "security:check": "npm audit --audit-level moderate",
    "dev": "webpack serve --mode=development",
    "package": "npm run build && zip -r autoscroll-extension.zip dist/"
  },
  "keywords": [
    "autoscroll",
    "browser-extension",
    "stealth",
    "human-simulation",
    "automation"
  ],
  "author": "Autoscroll Extension Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@testing-library/jest-dom": "^6.8.0",
    "babel-jest": "^30.1.2",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "chrome-types": "^0.1.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
