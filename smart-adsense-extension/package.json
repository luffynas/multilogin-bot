{
  "name": "smart-adsense-pro",
  "version": "1.0.0",
  "description": "Smart AdSense Pro - Chrome Extension for AdSense Optimization",
  "main": "background.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "build:prod": "webpack --config webpack.config.js --mode production",
    "watch": "webpack --config webpack.config.js --watch",
    "clean": "rimraf dist",
    "package": "npm run build && cd dist && zip -r ../smart-adsense-pro-v1.0.0.zip .",
    "dev": "npm run build:dev && npm run watch"
  },
  "keywords": [
    "chrome-extension",
    "adsense",
    "automation",
    "revenue-optimization",
    "smart-browsing"
  ],
  "author": "Smart AdSense Pro Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "rimraf": "^5.0.5"
  },
  "dependencies": {},
  "browserslist": [
    "chrome >= 88",
    "firefox >= 85"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smart-adsense-pro/extension.git"
  },
  "bugs": {
    "url": "https://github.com/smart-adsense-pro/extension/issues"
  },
  "homepage": "https://github.com/smart-adsense-pro/extension#readme"
}
