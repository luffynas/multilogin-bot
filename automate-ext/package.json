{
  "name": "adsense-automation-pro",
  "version": "1.2.0",
  "description": "Advanced automation extension for AdSense optimization and RPM improvement",
  "main": "content-script.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "build:prod": "webpack --config webpack.config.js --mode production",
    "clean": "rm -rf dist",
    "package:chrome": "npm run build:prod && cd dist && zip -r ../adsense-automation-pro-chrome.zip .",
    "package:firefox": "npm run build:prod && cd dist && zip -r ../adsense-automation-pro-firefox.zip .",
    "package:all": "npm run build:prod && cd dist && zip -r ../adsense-automation-pro-all.zip .",
    "analyze": "webpack --config webpack.config.js --analyze",
    "test": "node test-*.js",
    "lint": "eslint lib/*.js *.js",
    "format": "prettier --write lib/*.js *.js"
  },
  "keywords": [
    "adsense",
    "automation",
    "extension",
    "chrome",
    "firefox",
    "multilogin",
    "rpm",
    "optimization"
  ],
  "author": "AdSense Automation Pro Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "Chrome >= 88",
    "Firefox >= 85"
  ]
}
